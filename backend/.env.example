# ---------- App ----------
APP_ENV=development
APP_NAME=LiveTruth Shield
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ---------- Security ----------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRE_MINUTES=120
MEDIA_TOKEN_EXPIRE_MINUTES=60

# ---------- Database ----------
MONGO_URI=mongodb://localhost:27017
MONGO_DB=livetruth

# ---------- Storage ----------
STORAGE_DIR=./storage
MAX_UPLOAD_MB=500
MAX_VIDEO_MINUTES=30

# ---------- LLM (OpenAI or any OpenAI-compatible endpoint, e.g. Groq, Together, vLLM, Ollama) ----------
OPENAI_API_KEY=
OPENAI_BASE_URL=
LLM_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small
# "openai" (API) or "local" (Sentence Transformers on this machine, free; multilingual default model).
# Keep one provider per database: embeddings from different models can't be compared.
EMBEDDING_PROVIDER=openai
LOCAL_EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# ---------- Speech-to-text ----------
# "openai" = Whisper API (needs OPENAI_API_KEY), "local" = faster-whisper on this machine
STT_PROVIDER=openai
STT_MODEL=whisper-1
LOCAL_WHISPER_MODEL=base

# ---------- Evidence search ----------
# "tavily" (recommended), "serper", or "wikipedia" (free, no key, lower coverage)
SEARCH_PROVIDER=tavily
TAVILY_API_KEY=
SERPER_API_KEY=
# Optional: Google Fact Check Tools API key (Google Cloud console → enable "Fact Check Tools API" → create API key).
# Adds existing professional fact-checks (ClaimReview) as evidence.
FACTCHECK_API_KEY=
SEARCH_RESULTS_PER_CLAIM=6
# Source Trust Analyser: fetch each cited page (size/time-limited) to read author, date and references
TRUST_FETCH_METADATA=true
# Reuse search results for this many hours (faster, cheaper re-runs). 0 disables.
SEARCH_CACHE_HOURS=72

# ---------- Vector store ----------
# "chroma" (persistent, in STORAGE_DIR/chroma) or "memory" (numpy, no extra dependency)
VECTOR_STORE=chroma

# ---------- Pipeline ----------
MAX_CLAIMS_PER_VIDEO=25
# Context manipulation detector (1 extra LLM call per claim + 1 per video)
CONTEXT_ANALYSIS=true
MIN_EVIDENCE_SCORE=0.35
# ---------- Re-checks ----------
# Automatically re-verify completed analyses every N hours (0 = off). Re-checks reuse the
# transcript and claims, search for fresh evidence, and add a Truth Fingerprint version.
RECHECK_INTERVAL_HOURS=0
RECHECK_BATCH=5
# Privacy: delete uploaded video files and generated PDFs older than N days (analysis results are kept). 0 = keep.
RETENTION_DAYS=0

# ---------- Cost estimate (optional) ----------
# Fill in your providers' CURRENT prices to see an estimated cost per run. 0 = counts only.
PRICE_LLM_INPUT_PER_1M=0
PRICE_LLM_OUTPUT_PER_1M=0
PRICE_EMBEDDING_PER_1M=0
PRICE_STT_PER_MINUTE=0
PRICE_SEARCH_PER_CALL=0

ALLOWED_PLATFORMS=youtube.com,youtu.be,vimeo.com,dailymotion.com,x.com,twitter.com,tiktok.com,facebook.com,instagram.com
